# Hostinger injects these automatically when you connect the Supabase database.
# You do NOT need to set DATABASE_URL, NEXTAUTH_URL, NEXTAUTH_SECRET, or ADMIN_PASSWORD.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_API_KEY="your-supabase-key"

# Optional overrides (defaults are built-in):
# NEXTAUTH_URL="https://mcsogroup.com"
# NEXTAUTH_SECRET="auto-from-SUPABASE_API_KEY"
#
# IMPORTANT: Do not set DATABASE_URL to Hostinger/Postgres.
# This app always uses local SQLite (and ignores a non-file DATABASE_URL).
# DATABASE_URL="file:../data/prod.db"
#
# Demo admin (seeded automatically):
