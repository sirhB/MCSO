# ── Hostinger + Supabase (set these in hPanel → Environment Variables) ──
# Hostinger injects these when you connect the Supabase database:
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_API_KEY="your-supabase-anon-or-service-key"

# Prisma needs the Postgres URI (Supabase Dashboard → Project Settings → Database → Connect)
# Use the URI that includes your DB password (the one Hostinger showed once when creating the DB).
# Example (replace ref + password):
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ── Auth / admin ──
NEXTAUTH_URL="https://mcsogroup.com"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@mcso.local"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="MCSO Admin"
