generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres (Hostinger). Set DATABASE_URL to your Supabase connection URI.
// Optional DIRECT_URL is used for migrations when DATABASE_URL points at the pooler.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model SitePage {
  id            String    @id @default(cuid())
  slug          String    @unique @default("home")
  title         String
  draftData     String
  publishedData String?
  publishedAt   DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
}

model Inquiry {
  id            String         @id @default(cuid())
  name          String
  email         String
  phone         String?
  message       String
  status        String         @default("NEW")
  notes         String?
  contactId     String?
  contact       Contact?       @relation(fields: [contactId], references: [id])
  statusHistory StatusEvent[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model StatusEvent {
  id         String   @id @default(cuid())
  inquiryId  String
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())
}

model Contact {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  company   String?
  notes     String?
  inquiries Inquiry[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model GalleryImage {
  id          String   @id @default(cuid())
  src         String
  label       String?
  description String?
  category    String   @default("General")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}
